#!/bin/bash -l
# One-shot high-memory job: quantize the finches epsilon-matrix pickle
# (about 28 GB in RAM) into per-pair int8 .bin intermaps. Not an array job.
# Place all_interactions.pkl(.gz) and extract_intermaps.py in this dir, submit,
# then upload scores2d/ to R2 under public/interactions/scores2d/.
#$ -P <PROJECT>
#$ -N intermaps
#$ -pe omp 8
#$ -l mem_per_core=8G
#$ -l h_rt=4:00:00
#$ -j y
#$ -o extract_intermaps.log

conda activate consurf   # any environment with numpy

PKL=all_interactions.pkl.gz
[ -f "$PKL" ] || PKL=all_interactions.pkl
python3 extract_intermaps.py "$PKL" scores2d
